{
  "mail": {
    "imap": {
      "host": "imap.example.com",
      "port": 993,
      "secure": true,
      "user": "pi@example.com",
      "password": "<PASSWORD>",
      "folder": "INBOX",
      "authType": "LOGIN",
      "tokenCommand": []
    },
    "smtp": {
      "host": "smtp.example.com",
      "port": 465,
      "secure": true,
      "user": "pi@example.com",
      "password": "<PASSWORD>",
      "authType": "LOGIN",
      "tokenCommand": []
    },
    "to": "you@example.com"
  },
  "device": {
    "name": ""
  },
  "security": {
    "allowFrom": [
      "you@example.com"
    ],
    "requireDmarcPass": true,
    "allowHeaderThreading": true,
    "allowSelfReplies": false,
    "tokenTtlHours": 720
  },
  "daemon": {
    "host": "127.0.0.1",
    "port": 4177,
    "exitWhenIdle": true,
    "idleTimeoutSecs": 120
  },
  "notify": {
    "onSettled": true,
    "debounceMs": 10000,
    "notifyOnAborted": false
  },
  "tuning": {
    "idleRenewMs": 1500000,
    "backoffInitialMs": 1000,
    "backoffMaxMs": 60000
  }
}
