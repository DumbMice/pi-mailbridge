[Unit]
Description=pi-mailbridge daemon (IMAP watcher for pi coding-agent sessions)
Documentation=https://github.com/pi-mailbridge/pi-mailbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- adjust these lines -----------------------------------------------------
# Node is not /usr/bin/node on a machine where pi ships its own, so PATH carries the
# pi-managed one first. systemd cannot expand a variable in the *executable* position,
# hence /usr/bin/env does the lookup and the variables only appear in arguments.
# Check yours with `command -v node`.
Environment=PATH=%h/.local/share/pi-node/current/bin:/usr/local/bin:/usr/bin:/bin

# Where the package lives. For `pi install npm:pi-mailbridge` this default is right;
# for a local checkout point it at that directory instead.
Environment=PI_MAILBRIDGE_DIR=%h/.pi/agent/npm/node_modules/pi-mailbridge
# Environment=PI_MAILBRIDGE_DIR=%h/Work/pi-mailbridge

# systemd owns this process, so it must not exit when the last pi session stops
# pinging - Restart=always would turn that into a restart loop. Setting this beats
# editing the config file; the config key still works if you prefer it.
Environment=PI_MAILBRIDGE_EXIT_WHEN_IDLE=false
# ---------------------------------------------------------------------------

ExecStartPre=/usr/bin/env node --experimental-strip-types ${PI_MAILBRIDGE_DIR}/src/daemon/main.ts --check
ExecStart=/usr/bin/env node --experimental-strip-types ${PI_MAILBRIDGE_DIR}/src/daemon/main.ts

# The port is the single-instance lock: when pi's ensureDaemon() already owns it, this
# unit's start exits 0. Restart=always would then restart it every RestartSec forever, so
# only restart on failure - and treat the "somebody else owns the port" exit as success.
Restart=on-failure
RestartPreventExitStatus=0
RestartSec=5
# Logs go to the journal; the daemon writes its own daemon.log when spawned by pi.
StandardOutput=journal
StandardError=journal

# Hardening: loopback, the network, and its own state dir.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/state/pi-mailbridge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=default.target
