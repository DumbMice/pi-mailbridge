[Unit]
Description=pi-mailbridge daemon (IMAP watcher for pi coding-agent sessions)
Documentation=https://github.com/pi-mailbridge/pi-mailbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- adjust these two lines -------------------------------------------------
# Node: pi normally ships its own, which is why this is not /usr/bin/node.
# Check yours with `command -v node` and use an absolute path.
Environment=PI_MAILBRIDGE_NODE=%h/.local/share/pi-node/current/bin/node

# Where the package lives. For `pi install npm:pi-mailbridge` this default is
# already right; for a local checkout point it at that directory instead.
Environment=PI_MAILBRIDGE_DIR=%h/.pi/agent/npm/node_modules/pi-mailbridge
# Environment=PI_MAILBRIDGE_DIR=%h/Work/pi-mailbridge
# ---------------------------------------------------------------------------

ExecStartPre=${PI_MAILBRIDGE_NODE} --experimental-strip-types ${PI_MAILBRIDGE_DIR}/src/daemon/main.ts --check
ExecStart=${PI_MAILBRIDGE_NODE} --experimental-strip-types ${PI_MAILBRIDGE_DIR}/src/daemon/main.ts

# The port is the single-instance lock; a duplicate start exits 0 immediately,
# so Restart=always is safe.
Restart=always
RestartSec=5
# Logs go to the journal; the daemon writes its own daemon.log when spawned by pi.
StandardOutput=journal
StandardError=journal

# Hardening: loopback, the network, and its own state dir.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/pi-mailbridge
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M

[Install]
WantedBy=default.target
